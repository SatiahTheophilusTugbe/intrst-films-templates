    {"name":"Render platform-native payload","type":"n8n-nodes-base.code","typeVersion":2,"position":[1568,0],"parameters":{"mode":"runOnceForAllItems","jsCode":"const item=$('Resolve centralized distribution config').first().json;const o=item.output;const m=JSON.parse(o.manifest_json??'{}');const p=(m.platform_targets??[m.platform??'facebook'])[0];const r=item.distribution_config;const intent=typeof m.engagement_intent==='string'?m.engagement_intent:m.engagement_intent?.intent;if(!intent)throw new Error('MISSING_ENGAGEMENT_INTENT');const tags=Array.isArray(m.hashtags)?m.hashtags.slice(0,3):[];const body=String(m.caption??'').trim();const clean=body.endsWith(intent)?body.slice(0,-intent.length).trim():body;const tagLine=tags.length?'#'+tags.map(x=>String(x).replace(/^#/,'')).join(' #'):'';const firstComment=[intent,tagLine].filter(Boolean).join('\\n\\n');const caption=p==='facebook'||p==='instagram'?clean:p==='x'?[clean,tagLine].filter(Boolean).join('\\n\\n').slice(0,280):[clean,firstComment].filter(Boolean).join('\\n\\n');return [{json:{content_output_id:o.output_id,platform:p,account_id:r.accounts[p],adapter_mode:r.adapter_modes[p],caption,caption_body:clean,first_comment:['facebook','instagram'].includes(p)?firstComment:null,engagement_intent:m.engagement_intent,hashtags:tags,character_count:caption.length,render_version:'distribution-renderer@1.1.0',engagement_rendered:p!=='x',media_urls:[o.media_drive_url??''],title:m.title??null,distribution_config:r}}];"}},
