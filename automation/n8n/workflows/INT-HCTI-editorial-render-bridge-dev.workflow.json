      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f={subject:'Dolly Parton',story_label:'Literacy',subject_image:'https://commons.wikimedia.org/wiki/Special:FilePath/Young-Dolly-Parton.jpg',image_position:'58% 31%',kicker:'Stories worth remembering.',headline_html:'Her father<br>couldn’t read.<br><em>She built a library.</em>',dek:'In 1995, Dolly Parton turned a family wound into a system that put books directly into children’s homes.',source_line:'Sevier County, Tennessee · 1995',asset_id:'INT-AST-01K4X4Q7B6D0MMPY000000003',source_id:'SRC-010'};const e=v=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('\"','&quot;').replaceAll(\"'\",\"&#39;\");const h=f.headline_html.replace(/<br\\s*\\/?>/gi,'\\u0000').replace(/<em>([\\s\\S]*?)<\\/em>/gi,'\\u0001$1\\u0002');if(/[<>]/.test(h)||!/^(?:\\d{1,3}%|left|center|right)\\s+(?:\\d{1,3}%|top|center|bottom)$/.test(f.image_position))throw new Error('SCHEMA_VALIDATION');const headline=e(h).replace(/\\u0000/g,'<br>').replace(/\\u0001/g,'<em>').replace(/\\u0002/g,'</em>');const html='<!doctype html><html><head><meta charset=\"utf-8\"><style>@import url(\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Inter:wght@400;500;600&family=Manrope:wght@600;700&display=swap\");html,body{width:1080px;height:1350px;margin:0;overflow:hidden}body{background:#101925;color:#f7f0df;font-family:Inter,sans-serif}.frame{position:relative;width:1080px;height:1350px;overflow:hidden}.photo{position:absolute;inset:0;background-image:url(\"'+f.subject_image+'\");background-position:'+f.image_position+';background-size:cover}.scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,25,37,.18),rgba(16,25,37,.88))}.copy{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;padding:64px 72px 56px;box-sizing:border-box}.topbar,.footer{font:600 24px/1.2 Manrope,sans-serif;letter-spacing:.08em;text-transform:uppercase}.topbar{display:flex;justify-content:space-between}.kicker{margin:auto 0 18px;color:#f4c96b;font:600 24px/1.2 Manrope,sans-serif}h1{max-width:900px;margin:0 0 28px;font:600 112px/.88 \"Cormorant Garamond\",serif}h1 em{color:#f4c96b;font-style:normal}.dek{max-width:820px;margin:0 0 28px;font:500 30px/1.22 Inter,sans-serif}.footer{color:#d3d9e2;font-size:18px}</style></head><body><main class=\"frame\"><div class=\"photo\"></div><div class=\"scrim\"></div><section class=\"copy\"><div class=\"topbar\"><span>'+e(f.subject)+'</span><span>'+e(f.story_label)+'</span></div><div><div class=\"kicker\">'+e(f.kicker)+'</div><h1>'+headline+'</h1><p class=\"dek\">'+e(f.dek)+'</p></div><div class=\"footer\">'+e(f.source_line)+'</div></section></main></body></html>';const runId=$('Build workflow_runs START row').first().json.run_id;return [{json:{...f,run_id:runId,attempt_id:'hcti-render:'+runId,html,provider:'hcti',endpoint:'https://hcti.io/v1/image',template_version:'editorial-portrait-v01',source_commit:'9aa50d2994a90e08221c93e4417d0cdb4550ed23',width:1080,height:1350,automatic_retries:0,transport_attempt:1}}];"
