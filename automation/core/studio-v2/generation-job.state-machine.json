{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "STU-004-GENERATION-JOB",
  "contract_version": "generation-job@1.0.0",
  "status": "architecture_complete_runtime_not_deployed",
  "schema": "schemas/studio-v2-generation-job.schema.json",
  "job_states": [
    "planned",
    "validated",
    "continuity_verified",
    "routed",
    "budget_reserved",
    "claimed",
    "in_progress",
    "qc_pending",
    "creative_review",
    "accepted",
    "registered",
    "completed",
    "deferred",
    "blocked",
    "outcome_unknown",
    "failed_recoverable",
    "failed_terminal",
    "rejected",
    "cancelled",
    "dead_letter"
  ],
  "happy_path": [
    ["planned", "validated"],
    ["validated", "continuity_verified"],
    ["continuity_verified", "routed"],
    ["routed", "budget_reserved"],
    ["budget_reserved", "claimed"],
    ["claimed", "in_progress"],
    ["in_progress", "qc_pending"],
    ["qc_pending", "creative_review"],
    ["creative_review", "accepted"],
    ["accepted", "registered"],
    ["registered", "completed"]
  ],
  "exception_transitions": {
    "planned": ["cancelled", "blocked"],
    "validated": ["blocked", "cancelled"],
    "continuity_verified": ["blocked", "cancelled"],
    "routed": ["blocked", "cancelled"],
    "budget_reserved": ["blocked", "cancelled"],
    "claimed": ["in_progress", "outcome_unknown", "failed_terminal"],
    "in_progress": ["deferred", "qc_pending", "outcome_unknown", "failed_recoverable", "failed_terminal"],
    "deferred": ["in_progress", "outcome_unknown", "failed_recoverable", "failed_terminal"],
    "qc_pending": ["creative_review", "failed_recoverable", "failed_terminal", "rejected"],
    "creative_review": ["accepted", "rejected", "failed_recoverable"],
    "failed_recoverable": ["routed", "dead_letter"],
    "outcome_unknown": ["in_progress", "qc_pending", "failed_terminal", "dead_letter"],
    "rejected": [],
    "failed_terminal": [],
    "dead_letter": [],
    "cancelled": [],
    "blocked": []
  },
  "terminal_states": ["completed", "blocked", "failed_terminal", "rejected", "cancelled", "dead_letter"],
  "attempt_states": [
    "authorized",
    "claimed",
    "submitted",
    "provider_accepted",
    "processing",
    "retrieval_due",
    "retrieved",
    "evaluated",
    "known_failure",
    "outcome_unknown"
  ],
  "attempt_rules": [
    "A job has at most one active attempt.",
    "An attempt uses the same generation_job_id and a new immutable attempt_id and sequence number.",
    "Automatic paid-generation retries default to zero.",
    "A new attempt requires an explicit retry approval, remaining shot budget, a released or settled prior reservation, and no unresolved outcome_unknown attempt.",
    "Any error after request bytes may have crossed the provider boundary becomes outcome_unknown unless a provider rejection is positively established.",
    "outcome_unknown forbids resubmission until targeted reconciliation proves a terminal result.",
    "Provider fallback selection does not itself authorize a new attempt."
  ],
  "identity": {
    "job_idempotency_components": ["shot_id", "shot_manifest_hash", "continuity_state_hash", "generation_profile_version"],
    "attempt_operation_key_components": ["generation_job_id", "attempt_sequence", "provider", "model", "adapter_version", "prompt_hash", "input_asset_set_hash"],
    "claim_backend": "postgresql_atomic_compare_and_insert",
    "data_table_claims_allowed": false,
    "claim_proof_required": ["committed_write", "independent_readback", "project_owned_credential", "concurrent_winner_test"]
  },
  "checkpoints": [
    "validated_manifest_hash",
    "continuity_validation_id",
    "route_decision_id",
    "cost_reservation_entry_id",
    "attempt_claim_id",
    "provider_receipt_id",
    "next_action_at",
    "retrieved_asset_hash",
    "technical_qc_result_id",
    "continuity_qc_result_id",
    "creative_review_id",
    "selected_asset_id"
  ]
}
