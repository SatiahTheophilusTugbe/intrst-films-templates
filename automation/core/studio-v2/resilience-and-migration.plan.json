      "gates": ["accepted episode masters registered", "content_outputs adapter", "AUT-015 zero-call update", "AUT-014 remains separately gated"]
    }
  ],
  "rollback": {
    "architecture": "Revert the STU-004 Git commit; no runtime state exists.",
    "future_tables": "Archive only the six empty Studio tables after project-scoped identity verification; never delete production rows.",
    "future_workflows": "Keep inactive and restore prior version; do not mutate AUT-009, AUT-014 or AUT-015 as rollback shortcuts.",
    "legacy": "Documentary Story Object and existing outputs remain authoritative and untouched throughout migration."
  },
  "test_plan": [
    "schema_required_fields_and_additional_property_rejection",
    "typed_ID_and_version_invariants",
    "parent_child_reference_integrity",
    "documentary_story_object_non_regression",
    "continuity_hash_parent_and_compare_and_swap",
    "hard_soft_informational_assertion_outcomes",
    "router_hard_gate_and_deterministic_tie_break",
    "route_budget_and_catalog_version_invalidation",
    "generation_happy_path_and_invalid_transition_rejection",
    "one_active_attempt_and_unknown_outcome_no_retry",
    "integer_minor_unit_ledger_and_reservation_balance",
    "no_zero_denominator_metric_fabrication",
    "provider_error_normalization_and_secret_redaction",
    "atomic_claim_concurrency_and_independent_readback",
    "modular_workflow_graph_and_no_cycle_or_poll_loop",
    "workflow_runs_lineage_and_terminal_persistence",
    "asset_hash_provenance_and_selection_immutability",
