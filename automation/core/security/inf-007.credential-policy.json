{
  "$schema": "../../../schemas/credential-policy.schema.json",
  "schema_version": "1.0.0",
  "contract_id": "INF-007",
  "status": "development",
  "mode": "deny_by_default",
  "project": {
    "repository": "SatiahTheophilusTugbe/intrst-films-templates",
    "n8n_project_name": "INTRST Films",
    "n8n_project_id": "o8RQQQgne2c6jXr5"
  },
  "principles": [
    "least_privilege",
    "dedicated_integration_identity",
    "environment_isolation",
    "reference_not_value",
    "redact_before_persist",
    "fail_closed",
    "explicit_rotation_and_revocation"
  ],
  "secret_classes": [
    "api_key",
    "access_token",
    "refresh_token",
    "oauth_client_secret",
    "private_key",
    "service_account_key",
    "webhook_secret",
    "password",
    "session_cookie"
  ],
  "approved_stores": [
    {
      "surface": "n8n_runtime",
      "store": "n8n_credentials",
      "conditions": ["project_scoped_when_supported", "workflow_receives_reference_only", "raw_value_not_exported"]
    },
    {
      "surface": "codex_n8n_mcp",
      "store": "managed_oauth_connection",
      "conditions": ["interactive_login_only", "raw_value_not_entered_in_chat", "connection_scoped_to_authorized_instance"]
    },
    {
      "surface": "local_deployment_tooling",
      "store": "approved_environment_secret_store",
      "conditions": ["not_committed", "not_echoed", "not_written_to_artifacts", "dedicated_key_only"]
    }
  ],
  "prohibited_surfaces": [
    "git_repository",
    "workflow_export",
    "data_table",
    "workflow_run_log",
    "prompt_or_chat",
    "issue_or_pull_request",
    "screenshot_or_recording",
    "google_drive_document",
    "shell_history",
    "rendered_output"
  ],
  "credential_reference": {
    "field": "credential_ref",
    "naming_format": "INT | {Provider} | {Environment} | {Purpose}",
    "allowed_environments": ["Development", "Staging", "Production"],
    "allowed_repository_metadata": ["provider", "credential_type", "environment", "purpose", "logical_reference", "required_scopes"],
    "prohibited_repository_metadata": ["credential_id", "secret_value", "token_fragment", "authorization_header", "private_key_material", "raw_oauth_payload"]
  },
  "access_control": {
    "least_privilege_required": true,
    "dedicated_identity_required": true,
    "personal_login_allowed_only_when_provider_requires": true,
    "project_ownership_verification_required": true,
    "cross_project_reuse_allowed": false,
    "credential_value_inspection_by_codex_allowed": false,
    "credential_listing": "name_type_and_project_only",
    "production_use_requires_explicit_authorization": true
  },
  "environment_isolation": {
    "separate_credentials_required": true,
    "development_may_use_production_credential": false,
    "staging_may_use_production_credential": false,
    "fallback_to_other_environment_allowed": false,
    "promotion_copies_secret_values": false,
    "promotion_resolves_environment_specific_reference": true
  },
  "lifecycle": {
    "states": ["requested", "provisioned", "validated", "active", "rotation_due", "revoked", "retired"],
    "provisioning_requires": ["owner", "provider", "purpose", "environment", "minimum_scopes", "approved_store"],
    "validation": "non_mutating_healthcheck_when_available",
    "static_secret_max_age_days": 90,
    "rotation_events": ["suspected_exposure", "confirmed_exposure", "owner_departure", "scope_reduction", "provider_requirement", "failed_security_review"],
    "revocation_is_immediate_on_exposure": true,
    "retired_credentials_must_not_remain_referenced": true
  },
  "observability": {
    "allowed_fields": ["credential_ref", "provider", "credential_type", "environment", "purpose", "health_status", "checked_at", "error_class"],
    "prohibited_fields": ["secret_value", "authorization_header", "token_fragment", "request_headers", "raw_provider_payload", "private_key_material"],
    "redaction_required_before_logging": true,
    "redaction_replacement": "[REDACTED]"
  },
  "failure_policy": {
    "error_class": "CREDENTIAL_FAILURE",
    "retry": "none_until_operator_resolution",
    "workflow_action": "stop_and_alert",
    "fallback_to_different_credential": false,
    "fallback_to_different_environment": false,
    "record_secret_value_in_error": false
  },
  "break_glass": {
    "enabled": true,
    "requires_explicit_user_or_admin_authorization": true,
    "time_bounded": true,
    "minimum_record": ["actor", "reason", "scope", "started_at", "expires_at", "affected_credential_ref"],
    "post_event_rotation_required": true,
    "post_event_review_required": true
  },
  "incident_response": {
    "actions": ["stop_affected_execution", "alert_operator", "revoke_affected_secret", "replace_environment_reference", "verify_redaction", "document_decision", "run_regression_tests"],
    "automatic_cross_project_action_allowed": false,
    "production_reactivation_requires_explicit_authorization": true
  },
  "deployment_gate": {
    "required_before": ["AUT-003", "external_provider_adapter", "workflow_activation", "production_promotion"],
    "checks": ["reference_resolves", "environment_matches", "minimum_scopes_confirmed", "healthcheck_passes", "logs_are_redacted", "rollback_or_revocation_path_exists"],
    "failure_behavior": "block"
  }
}
