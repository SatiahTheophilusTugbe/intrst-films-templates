{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrstfilms.com/schemas/n8n-data-tables.schema.json",
  "title": "INTRST n8n Data Tables Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_status", "n8n_version", "project", "storage_policy", "open_dependencies", "deployment", "tables"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "INF-005"},
    "contract_status": {"enum": ["development", "approved", "superseded"]},
    "n8n_version": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"const": "o8RQQQgne2c6jXr5"},
        "name": {"const": "INTRST Films"}
      }
    },
    "storage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents_and_media_authority", "operational_state_authority", "nested_values", "timestamps", "logical_uniqueness", "secrets_allowed"],
      "properties": {
        "documents_and_media_authority": {"const": "google_drive"},
        "operational_state_authority": {"const": "n8n_data_tables"},
        "nested_values": {"const": "json_encoded_string"},
        "timestamps": {"const": "utc"},
        "logical_uniqueness": {"const": "workflow_enforced"},
        "secrets_allowed": {"const": false}
      }
    },
    "open_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1}
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "status", "mutation_authorized_by", "expected_current_state", "idempotency_key", "rollback_method"],
      "properties": {
        "environment": {"const": "development"},
        "status": {"enum": ["planned", "deployed", "rolled_back"]},
        "mutation_authorized_by": {"type": "string", "minLength": 1},
        "expected_current_state": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "rollback_method": {"type": "string", "minLength": 1}
      }
    },
    "tables": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/table"}
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "logical_key", "idempotency_key", "columns"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "purpose": {"type": "string", "minLength": 1},
        "logical_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "idempotency_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}}
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["string", "number", "boolean", "date"]},
        "required": {"type": "boolean"}
      }
    }
  }
}
