{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrstfilms.com/schemas/studio-v2-model-route.schema.json",
  "title": "INTRST Studio v2 Model Route",
  "$defs": {
    "routeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "route_decision_id", "generation_job_id", "shot_id", "shot_manifest_hash", "continuity_state_id", "continuity_state_hash", "generation_profile_version", "route_policy_version", "model_catalog_version", "requirements", "budget", "candidates", "idempotency_key"],
      "properties": {
        "contract_version": {"const": "model-router@1.0.0"},
        "route_decision_id": {"type": "string", "pattern": "^INT-RTE-[0-9A-HJKMNP-TV-Z]{26}$"},
        "generation_job_id": {"type": "string", "pattern": "^INT-GJB-[0-9A-HJKMNP-TV-Z]{26}$"},
        "shot_id": {"type": "string", "pattern": "^INT-SHT-[0-9A-HJKMNP-TV-Z]{26}$"},
        "shot_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "continuity_state_id": {"type": "string", "pattern": "^INT-CNT-[0-9A-HJKMNP-TV-Z]{26}$"},
        "continuity_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generation_profile_version": {"type": "string"},
        "route_policy_version": {"const": "studio-route-score@1.0.0"},
        "model_catalog_version": {"type": "string"},
        "requirements": {"type": "object", "additionalProperties": true, "required": ["task", "modality", "aspect_ratio", "width", "height", "duration_seconds", "commercial_use_required", "identity_consistency", "performance", "camera_motion", "dialogue_lip_sync", "environment", "data_region"]},
        "budget": {"type": "object", "additionalProperties": false, "required": ["currency", "ceiling_minor"], "properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "ceiling_minor": {"type": "integer", "minimum": 0}}},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
        "idempotency_key": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "adapter", "adapter_version", "credential_ref", "commercial_use_permitted", "budget_reservation_possible", "capabilities", "estimated_cost_minor", "currency", "p95_latency_ms", "circuit_state", "scores", "evidence"],
      "properties": {
        "provider": {"type": "string"}, "model": {"type": "string"}, "adapter": {"type": "string"}, "adapter_version": {"type": "string"}, "credential_ref": {"type": "string"}, "commercial_use_permitted": {"type": "boolean"}, "budget_reservation_possible": {"type": "boolean"}, "capabilities": {"type": "object"}, "estimated_cost_minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "p95_latency_ms": {"type": "integer", "minimum": 0}, "circuit_state": {"enum": ["closed", "open", "half_open_manual_canary"]}, "scores": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}}, "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "routeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "route_decision_id", "status", "route_policy_version", "model_catalog_version", "candidate_results", "automatic_provider_calls", "automatic_retries"],
      "properties": {
        "contract_version": {"const": "model-router@1.0.0"}, "route_decision_id": {"type": "string"}, "status": {"enum": ["selected", "blocked", "manual_review_required"]}, "selected": {"type": ["object", "null"]}, "candidate_results": {"type": "array"}, "route_policy_version": {"type": "string"}, "model_catalog_version": {"type": "string"}, "automatic_provider_calls": {"const": 0}, "automatic_retries": {"const": 0}
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/routeRequest"}, {"$ref": "#/$defs/routeDecision"}]
}
