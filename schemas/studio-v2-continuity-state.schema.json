{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrstfilms.com/schemas/studio-v2-continuity-state.schema.json",
  "title": "INTRST Studio v2 Continuity State",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "continuity_state_id", "series_id", "version", "parent_state_id", "scope", "state", "state_hash", "mutation_ids", "approval_record_id", "created_at"],
  "properties": {
    "contract_version": {"const": "continuity-engine@1.0.0"},
    "continuity_state_id": {"type": "string", "pattern": "^INT-CNT-[0-9A-HJKMNP-TV-Z]{26}$"},
    "series_id": {"type": "string", "pattern": "^INT-SER-[0-9A-HJKMNP-TV-Z]{26}$"},
    "episode_id": {"type": ["string", "null"], "pattern": "^INT-EPI-[0-9A-HJKMNP-TV-Z]{26}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "parent_state_id": {"type": ["string", "null"], "pattern": "^INT-CNT-[0-9A-HJKMNP-TV-Z]{26}$"},
    "scope": {"enum": ["series_genesis", "episode_in", "episode_out"]},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characters", "relationships", "locations", "props", "timeline_facts", "unresolved_promises"],
      "properties": {
        "characters": {"type": "object"},
        "relationships": {"type": "object"},
        "locations": {"type": "object"},
        "props": {"type": "object"},
        "timeline_facts": {"type": "array"},
        "unresolved_promises": {"type": "array"}
      }
    },
    "state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mutation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "approval_record_id": {"type": ["string", "null"], "pattern": "^INT-REV-[0-9A-HJKMNP-TV-Z]{26}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "series_genesis"}}}, "then": {"properties": {"parent_state_id": {"type": "null"}}}},
    {"if": {"properties": {"scope": {"enum": ["episode_in", "episode_out"]}}}, "then": {"required": ["episode_id"], "properties": {"parent_state_id": {"type": "string"}}}},
    {"if": {"properties": {"scope": {"const": "episode_out"}}}, "then": {"properties": {"approval_record_id": {"type": "string", "pattern": "^INT-REV-"}}}}
  ]
}
