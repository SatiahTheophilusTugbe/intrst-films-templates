{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrstfilms.com/schemas/life-file.schema.json",
  "title": "INTRST Films Life File",
  "description": "Canonical structured subject record used to power research, editorial planning, asset verification, and downstream content generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "person_id",
    "identity",
    "editorial",
    "chronology",
    "legacy",
    "sources",
    "assets",
    "verification",
    "risk",
    "workflow"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "person_id": {"type": "string", "minLength": 3},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "display_name", "category", "life_status"],
      "properties": {
        "full_name": {"type": "string"},
        "display_name": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "category": {"type": "string", "enum": ["entertainment", "music", "sports", "business", "politics_history", "science_innovation", "culture", "other"]},
        "occupation_labels": {"type": "array", "items": {"type": "string"}},
        "birth_date": {"type": ["string", "null"], "format": "date"},
        "birth_place": {"type": ["string", "null"]},
        "life_status": {"type": "string", "enum": ["living", "deceased"]},
        "death_date": {"type": ["string", "null"], "format": "date"},
        "death_place": {"type": ["string", "null"]},
        "death_cause_status": {"type": "string", "enum": ["not_applicable", "confirmed", "unconfirmed", "not_disclosed", "conflicting_reports"]},
        "death_cause": {"type": ["string", "null"]},
        "nationality": {"type": "array", "items": {"type": "string"}}
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_thesis", "story_angle", "content_pillars", "why_now", "story_value_score"],
      "properties": {
        "core_thesis": {"type": "string", "minLength": 20},
        "story_angle": {"type": "string"},
        "why_now": {"type": "string"},
        "content_pillars": {
          "type": "array",
          "items": {"type": "string", "enum": ["final_chapters", "before_they_were_icons", "cost_of_greatness", "what_they_left_behind", "lives_that_changed_everything", "forgotten_giants", "one_life_one_moment"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "trigger_type": {"type": "string", "enum": ["breaking_death", "recent_death", "anniversary", "trend", "evergreen", "historical_relevance", "editorial_choice", "other"]},
        "story_value_score": {"type": "number", "minimum": 0, "maximum": 100},
        "urgency_score": {"type": "number", "minimum": 0, "maximum": 100},
        "audience_relevance": {"type": "string"},
        "recommended_formats": {"type": "array", "items": {"type": "string", "enum": ["image_post", "carousel", "short_hook_reveal", "short_timeline_sprint", "short_single_moment", "youtube_longform", "newsletter", "web_article"]}, "uniqueItems": true}
      }
    },
    "chronology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childhood", "formative_years", "first_break", "rise", "peak", "cost_or_struggle", "final_years", "defining_moments"],
      "properties": {
        "childhood": {"$ref": "#/$defs/storySection"},
        "formative_years": {"$ref": "#/$defs/storySection"},
        "first_break": {"$ref": "#/$defs/storySection"},
        "rise": {"$ref": "#/$defs/storySection"},
        "peak": {"$ref": "#/$defs/storySection"},
        "cost_or_struggle": {"$ref": "#/$defs/storySection"},
        "final_years": {"$ref": "#/$defs/storySection"},
        "defining_moments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date_label", "title", "description", "why_it_matters", "source_ids"],
            "properties": {
              "date_label": {"type": "string"},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "why_it_matters": {"type": "string"},
              "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family_context": {"type": "string"},
        "key_people": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "relationship", "relevance"],
            "properties": {
              "name": {"type": "string"},
              "relationship": {"type": "string"},
              "relevance": {"type": "string"}
            }
          }
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lasting_impact", "what_remains", "cultural_or_industry_effect", "legacy_thesis"],
      "properties": {
        "lasting_impact": {"type": "string"},
        "what_remains": {"type": "string"},
        "cultural_or_industry_effect": {"type": "string"},
        "estate_or_organization_context": {"type": ["string", "null"]},
        "legacy_thesis": {"type": "string"},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/sourceRecord"}
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_images", "approved_images"],
      "properties": {
        "reference_images": {"type": "array", "items": {"$ref": "#/$defs/imageAsset"}, "minItems": 1},
        "approved_images": {"type": "array", "items": {"$ref": "#/$defs/imageAsset"}},
        "approved_video": {"type": "array", "items": {"$ref": "#/$defs/mediaAsset"}},
        "approved_objects_or_documents": {"type": "array", "items": {"$ref": "#/$defs/mediaAsset"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_confidence", "identity_verification_status", "death_verification_status", "ready_for_publishing"],
      "properties": {
        "fact_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "identity_verification_status": {"type": "string", "enum": ["pending", "verified", "review_required", "failed"]},
        "death_verification_status": {"type": "string", "enum": ["not_applicable", "pending", "verified_two_sources", "review_required", "failed"]},
        "conflicting_claims": {"type": "array", "items": {"type": "string"}},
        "unsupported_claims_removed": {"type": "boolean"},
        "ready_for_publishing": {"type": "boolean"},
        "review_notes": {"type": "string"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity_flags", "human_review_required"],
      "properties": {
        "sensitivity_flags": {"type": "array", "items": {"type": "string", "enum": ["death", "cause_of_death", "medical", "suicide", "overdose", "violence", "criminal_allegation", "lawsuit", "politics", "religion", "family_dispute", "estate_finance", "minor", "sexual_content", "none"]}, "uniqueItems": true},
        "human_review_required": {"type": "boolean"},
        "rights_or_likeness_notes": {"type": "string"},
        "editorial_cautions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "created_at", "updated_at"],
      "properties": {
        "status": {"type": "string", "enum": ["researching", "verification", "editorial_review", "approved", "blocked", "archived"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "research_run_id": {"type": ["string", "null"]},
        "approved_by": {"type": ["string", "null"]},
        "drive_folder_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  },
  "$defs": {
    "storySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "key_facts", "source_ids"],
      "properties": {
        "summary": {"type": "string"},
        "key_facts": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "visual_opportunities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "publisher", "source_type", "reliability_tier", "accessed_at"],
      "properties": {
        "source_id": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "publisher": {"type": "string"},
        "title": {"type": "string"},
        "published_at": {"type": ["string", "null"]},
        "accessed_at": {"type": "string", "format": "date-time"},
        "source_type": {"type": "string", "enum": ["official", "institutional", "major_news", "local_news", "archive", "book", "interview", "academic", "verified_social", "database", "other"]},
        "reliability_tier": {"type": "integer", "minimum": 1, "maximum": 4},
        "supports_claims": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "url", "source_url", "asset_role", "identity_confidence", "license_status", "approval_status"],
      "properties": {
        "asset_id": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "source_url": {"type": "string", "format": "uri"},
        "asset_role": {"type": "string", "enum": ["primary_portrait", "young_portrait", "late_life_portrait", "event", "group", "archival", "object", "document", "environment", "other"]},
        "caption": {"type": "string"},
        "date_or_era": {"type": ["string", "null"]},
        "identity_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "vision_match_status": {"type": "string", "enum": ["verified", "review_required", "rejected", "not_applicable"]},
        "group_photo_flag": {"type": "boolean"},
        "crop_verified": {"type": "boolean"},
        "license_status": {"type": "string", "enum": ["public_domain", "licensed", "editorial_use", "permission_granted", "unknown", "restricted"]},
        "approval_status": {"type": "string", "enum": ["approved", "review_required", "rejected"]},
        "notes": {"type": "string"}
      }
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "url", "source_url", "license_status", "approval_status"],
      "properties": {
        "asset_id": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "source_url": {"type": "string", "format": "uri"},
        "description": {"type": "string"},
        "license_status": {"type": "string", "enum": ["public_domain", "licensed", "editorial_use", "permission_granted", "unknown", "restricted"]},
        "approval_status": {"type": "string", "enum": ["approved", "review_required", "rejected"]}
      }
    }
  }
}
