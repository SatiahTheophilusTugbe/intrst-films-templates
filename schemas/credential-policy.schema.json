{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrstfilms.com/schemas/credential-policy.schema.json",
  "title": "INTRST Credential and Secrets Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "status", "mode", "project", "principles", "secret_classes", "approved_stores", "prohibited_surfaces", "credential_reference", "access_control", "environment_isolation", "lifecycle", "observability", "failure_policy", "break_glass", "incident_response", "deployment_gate"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "INF-007"},
    "status": {"enum": ["development", "approved", "superseded"]},
    "mode": {"const": "deny_by_default"},
    "project": {"type": "object"},
    "principles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "secret_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "approved_stores": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "prohibited_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "credential_reference": {"type": "object"},
    "access_control": {"type": "object"},
    "environment_isolation": {"type": "object"},
    "lifecycle": {"type": "object"},
    "observability": {"type": "object"},
    "failure_policy": {"type": "object"},
    "break_glass": {"type": "object"},
    "incident_response": {"type": "object"},
    "deployment_gate": {"type": "object"}
  }
}
