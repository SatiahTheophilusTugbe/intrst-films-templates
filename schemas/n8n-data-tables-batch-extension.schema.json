{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intrstfilms.com/schemas/n8n-data-tables-batch-extension.schema.json",
  "title": "INTRST n8n Data Tables Batch Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extension_id", "extension_version", "status", "base_contract", "decision_source", "project", "deployment", "tables", "runtime_invariants"],
  "properties": {
    "$schema": {"type":"string"},
    "schema_version": {"const":"1.0.0"},
    "extension_id": {"const":"INF-005.2"},
    "extension_version": {"const":"1.0.0"},
    "status": {"enum":["planned","deployed","rolled_back","superseded"]},
    "base_contract": {"type":"object"},
    "decision_source": {"type":"object"},
    "project": {"type":"object"},
    "deployment": {"type":"object"},
    "tables": {"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/table"}},
    "runtime_invariants": {"type":"array","minItems":1,"items":{"type":"string"}}
  },
  "$defs": {
    "table": {
      "type":"object","additionalProperties":false,"required":["name","purpose","logical_key","idempotency_key","columns"],
      "properties": {
        "name":{"enum":["media_sources","media_intelligence","provider_usage"]},
        "purpose":{"type":"string","minLength":1},
        "logical_key":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "idempotency_key":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "columns":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/column"}}
      }
    },
    "column": {
      "type":"object","additionalProperties":false,"required":["name","type","required"],
      "properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"type":{"enum":["string","number","boolean","date"]},"required":{"type":"boolean"}}
    }
  }
}
